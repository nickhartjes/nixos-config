# nvim with no swap, undo or shada files: the plaintext must not outlive
# agenix's temp dir (VS Code's local history kept copies). No spaces in the
# args, because agenix runs $EDITOR unquoted.
export EDITOR := "nvim --clean -n -i NONE"

# List available commands
default:
    @just --list

# Create or edit a secret file (usage: just create-secret filename.age)
create-secret filename:
    agenix -e {{filename}}

# Edit an existing secret file (usage: just edit-secret filename.age)
edit-secret filename:
    agenix -e {{filename}}

# Export decrypted secret content to a plaintext file (usage: just export-secret input.age output.txt)
export-secret source target:
    @echo "Warning: writing decrypted secret to {{target}}"
    umask 077 && agenix -d {{source}} > {{target}}
    chmod 600 {{target}}